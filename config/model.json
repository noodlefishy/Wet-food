{
  "architecture": {
    "vocab_size": 1024,
    "block_size": 64,
    "embed_dim": 80,
    "num_heads": 4,
    "num_layers": 4
  },
  "training": {
    "device": "cpu",
    "total_steps": 7000,
    "warmup_steps": 300,
    "base_lr": 0.002,
    "min_lr": 0.0002,
    "half_batch": 16,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "loss_weights": {
      "qa": 2.5,
      "story": 0.3
    }
  },
  "dataset": {
    "url": "https://huggingface.co/datasets/roneneldan/TinyStories/resolve/main/TinyStories-valid.txt",
    "logic_samples_target": 25000,
    "eval_samples_per_category": 15,
    "name_replacements": {
      "bob": ["timmy", "tom", "jack"],
      "alice": ["lily", "anna", "sarah"],
      "felix": [ "jane", "lucy", "emma"],
      "luna": ["billy", "sam", "billy"]
    },
"core_words": [
      "<unk>", "<pad>", "<eos>", ".", "?", ":", ",", "[c]", "[q]", "[a]",
      "question", "answer",

      "the", "in", "to", "from", "of", "a", "and", "or",
      "who", "what", "where", "how", "many",
      "is", "are", "was", "were", "does", "did",

      "he", "she", "they",

      "alice", "bob", "felix", "luna",
      "cat", "cats",

      "garden", "kitchen", "park", "room",

      "ball", "box", "book", "cup", "key", "bag",

      "red", "blue", "yellow", "green", "colour",

      "hot", "cold",
      "heavy", "light",
      "clean", "dirty",
      "open", "closed",

      "north", "south",

      "first", "then", "now", "before", "after",

      "yes", "no",
      "one", "two", "three", "none",
      "nobody", "nothing", "nowhere",

      "went", "gave", "got", "has", "had", "have", "found", "find",
      "put", "left", "likes", "wants",

      "hungry", "tired", "thirsty",

      "pico", "wifi"
    ]
  },
  "paths": {
    "models_dir": "models/local",
    "stories_file": "stories.txt",
    "questions_file": "config/questions.json"
  }
}