{
  "architecture": {
    "vocab_size": 1024,
    "block_size": 64,
    "embed_dim": 120,
    "num_heads": 6,
    "num_layers": 6,
    "meow_layers": 3,
    "miaou_layers": 3,
    "pos_embedding": "rope",
    "window_size": 20,
    "sink_size": 4
  },
  "training": {
    "device": "cuda",
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "pretrain": {
      "steps": 10000,
      "batch_size": 32,
      "warmup_steps": 500,
      "base_lr": 0.002,
      "min_lr": 0.0002
    },
    "sft": {
      "steps": 16000,
      "batch_size": 24,
      "base_lr": 0.00045,
      "min_lr": 0.000045
    },
    "weights": {
      "01: Single Supporting Fact": 18.0,
      "02: Two Supporting Facts": 2.0,
      "03: Three Supporting Facts": 2.0,
      "04: Two Argument Relations": 3.0,
      "05: Three Argument Relations": 2.0,
      "06: Yes/No Truth Verification": 8.0,
      "07: Counting": 4.0,
      "07: Counting Inverse Symmetry": 4.0,
      "08: Lists and Sets": 4.0,
      "09: Simple Negation": 2.5,
      "10: Indefinite Knowledge": 2.5,
      "11: Basic Coreference": 2.0,
      "12: Conjunction": 8.0,
      "13: Compound Coreference": 3.0,
      "14: Time Reasoning": 2.0,
      "15: Basic Deduction": 2.0,
      "16: Basic Induction": 8.0,
      "17: Positional Reasoning": 3.0,
      "18: Size Reasoning": 3.0,
      "19: Micro Navigation": 2.0,
      "20: Agent Motivations": 2.0,
      "22: Polar Possession": 8.0,
      "23: Basic Arithmetic": 1.5,
      "24: Direct Arithmetic": 1.5,
      "25: Propositional Logic": 1.5,
      "26: Comparative Chains": 2.0,
      "27: General Conversation": 1.5
    }
  },
  "dataset": {
    "url": "https://huggingface.co/datasets/roneneldan/TinyStories/resolve/main/TinyStories-valid.txt",
    "logic_samples_target": 8000,
    "core_words": [
      "<unk>", "<pad>", "<eos>", ".", "?", ":", ",", "[c]", "[q]", "[a]",
