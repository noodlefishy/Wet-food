    },
    {
      "name": "20: Agent Motivations",
      "weight": 2.0,
      "chain": ["state", "motion"],
      "connector": " . then ",
      "relational_queries": [
        {"q": "why did {actor1} go to the {location1}", "a": "{needs1_state}"},
        {"q": "who is {needs1_state}", "a": "{actor1}"},
        {"q": "who is thirsty", "a": "nobody"}
      ]
    },

    {
      "name": "21: Cross-Task Query Transfer (State to Location)",
      "weight": 2.5,
      "chain": ["state", "motion"],
      "connector": " . then ",
      "relational_queries": [
        {"q": "where is {actor1}", "a": "{location1}"},
        {"q": "where did {actor1} go", "a": "{location1}"}
      ]
    },
    {
      "name": "22: Polar Possession Verification (does ... have)",
      "weight": 2.5,
      "chain": ["possession_multi"],
      "connector": " . ",
      "relational_queries": [
        {"q": "does {actor1} have the {item1}", "a": "yes"},
        {"q": "does {actor1} have the {item2}", "a": "yes"},
        {"q": "does {actor2} have the {item3}", "a": "yes"},
        {"q": "does {actor1} have the {item3}", "a": "no"},
        {"q": "does {actor2} have the {item1}", "a": "no"},
        {"q": "does {actor3} have the {item1}", "a": "no"}
      ]
    },
    {
      "name": "23: Selective Departure (The Frame Problem)",
      "weight": 2.5,
      "chain": ["co_presence", "motion"],
      "connector": " . then ",
      "relational_queries": [
        {"q": ["where is {actor2}", "where did {actor2} stay"], "a": "{location1}"},
        {"q": ["where is {actor1}", "where did {actor1} go"], "a": "{location2}"},
        {"q": "who stayed in the {location1}", "a": "{actor2}"},
        {"q": "who went to the {location2}", "a": "{actor1}"}
      ]
    },
    {
      "name": "24: Transferred Attribute Preservation (Colour + Transfer)",
      "weight": 3.0,
      "chain": ["discovery_colour", "transfer"],
      "connector": " . then ",
      "relational_queries": [
        {"q": "who has the {colour1} {item1}", "a": "{actor2}"},
        {"q": "who had the {colour1} {item1} first", "a": "{actor1}"},
        {"q": "what colour is the {item1}", "a": "{colour1}"}
      ]
    },
    {
      "name": "25: Relational Symmetry Inversion (smaller in yes/no)",
      "weight": 2.0,
      "chain": ["size_chain"],
      "connector": " . ",
      "relational_queries": [
        {"q": "is the {item3} smaller than the {item1}", "a": "yes"},
        {"q": "is the {item1} smaller than the {item3}", "a": "no"}
      ]
    }
