{
  "pools": {
    "actor": ["alice", "bob", "felix", "luna"],
    "location": ["garden", "kitchen", "park", "room"],
    "item": ["ball", "box", "book", "cup"],
    "colour": ["red", "blue", "yellow", "green"],
    "container": ["box", "bag", "basket", "drawer"]
  },
  "pair_pools": {
    "agent": [
      {"name": "alice", "pronoun": "she"},
      {"name": "luna", "pronoun": "she"},
      {"name": "bob", "pronoun": "he"},
      {"name": "felix", "pronoun": "he"}
    ],
    "mutation": [
      {"item": "cup", "was": "cold", "now": "hot"},
      {"item": "cup", "was": "hot", "now": "cold"},
      {"item": "box", "was": "heavy", "now": "light"},
      {"item": "box", "was": "light", "now": "heavy"},
      {"item": "ball", "was": "clean", "now": "dirty"},
      {"item": "ball", "was": "dirty", "now": "clean"},
      {"item": "book", "was": "open", "now": "closed"},
      {"item": "book", "was": "closed", "now": "open"}
    ],
    "needs": [
      {"state": "hungry", "target": "kitchen", "noun": "food"},
      {"state": "tired", "target": "room", "noun": "sleep"},
      {"state": "thirsty", "target": "kitchen", "noun": "water"}
    ]
  },

  "clauses": {
    "motion": {
      "templates": [
        "{actor1} went to the {location1}",
        "{actor1} is in the {location1}",
        "{actor1} was in the {location1}"
      ],
      "queries": [
        {"q": ["where is {actor1}", "where was {actor1}"], "a": "{location1}"},
        {"q": ["who went to the {location1}", "who is in the {location1}"], "a": "{actor1}"}
      ]
    },

    "state": {
      "templates": [
        "{actor1} is {needs1_state}",
        "{actor1} was {needs1_state}"
      ],
      "queries": [
        {"q": "who is {needs1_state}", "a": "{actor1}"},
        {"q": "who was {needs1_state}", "a": "{actor1}"}
      ]
    },

    "acquisition": {
      "templates": [
        "{actor1} found the {item1} in the {location1}",
        "{actor1} got the {item1} in the {location1}",
        "first {actor1} found the {item1} in the {location1}"
      ],
      "queries": [
        {"q": "where was the {item1} first", "a": "{location1}"},
        {"q": "where was {actor1} first", "a": "{location1}"},
        {"q": ["who has the {item1}", "who got the {item1}"], "a": "{actor1}"}
      ]
    },

    "drop": {
      "templates": [
        "{actor1} left the {item1} in the {location2}",
        "{actor1} put the {item1} in the {location2}"
      ],
      "queries": [
        {"q": "where is the {item1} now", "a": "{location2}"},
        {"q": "who has the {item1} now", "a": "nobody"}
      ]
    },

    "possession_multi": {
      "templates": [
        "{actor1} has the {item1} and the {item2} . {actor2} has the {item3}",
        "{actor2} has the {item3} . {actor1} has the {item1} and the {item2}",
        "{actor1} has a {item1} and a {item2} . {actor2} has a {item3}"
      ],
      "queries": [
        {"q": "what does {actor1} have", "a": "{item1} and {item2}"},
        {"q": "what does {actor2} have", "a": "{item3}"},
        {"q": "what does {actor3} have", "a": "nothing"},
        {"q": ["how many items does {actor1} have", "how many items has {actor1}"], "a": "two"},
        {"q": ["how many items does {actor2} have", "how many items has {actor2}"], "a": "one"},
        {"q": ["how many items does {actor3} have", "how many items has {actor3}"], "a": "none"}
      ]
    },

    "transfer": {
      "templates": [
        "{actor1} gave the {item1} to {actor2}",
        "{actor1} gave a {item1} to {actor2}"
      ],
      "queries": [
        {"q": "who gave the {item1} to {actor2}", "a": "{actor1}"},
        {"q": ["who got the {item1}", "who got the {item1} from {actor1}"], "a": "{actor2}"},
        {"q": "who has the {item1} now", "a": "{actor2}"}
      ]
    },

    "co_presence": {
      "templates": [
        "{actor1} and {actor2} were in the {location1}",
        "{actor2} and {actor1} were in the {location1}",
        "{actor1} and {actor2} went to the {location1}"
      ],
      "queries": [
        {"q": "where is {actor1}", "a": "{location1}"},
        {"q": "where is {actor2}", "a": "{location1}"},
        {"q": "who is in the {location1}", "a": "{actor1} and {actor2}"}
      ]
    },

    "discovery_colour": {
      "templates": [
        "{actor1} had a {colour1} {item1}",
        "{actor1} found a {colour1} {item1}",
        "{actor1} has a {colour1} {item1}"
      ],
      "queries": [
        {"q": ["what does {actor1} have", "what did {actor1} find"], "a": "{item1}"},
        {"q": "what colour is the {item1}", "a": "{colour1}"},
        {"q": "who has the {colour1} {item1}", "a": "{actor1}"}
      ]
    },

    "negation": {
      "templates": [
        "{actor1} is not in the {location1} . {actor1} is in the {location2}",
        "{actor1} is in the {location2} . {actor1} is not in the {location1}"
      ],
      "queries": [
        {"q": "where is {actor1}", "a": "{location2}"},
        {"q": "is {actor1} in the {location1}", "a": "no"},
        {"q": "is {actor1} in the {location2}", "a": "yes"}
      ]
    },

    "disjunction": {
      "templates": [
        "{actor1} is in the {location1} or the {location2} . {actor1} is not in the {location1}",
        "{actor1} is not in the {location1} . {actor1} is in the {location1} or the {location2}"
      ],
      "queries": [
        {"q": "where is {actor1}", "a": "{location2}"},
        {"q": "is {actor1} in the {location1}", "a": "no"},
        {"q": "is {actor1} in the {location2}", "a": "yes"}
      ]
    },

    "compass": {
      "templates": [
        "the {location1} is north of the {location2} . the {location2} is north of the {location3}",
        "the {location2} is north of the {location3} . the {location1} is north of the {location2}"
      ],
      "queries": [
        {"q": "what is north of the {location2}", "a": "{location1}"},
        {"q": "what is south of the {location2}", "a": "{location3}"},
        {"q": "what is north of the {location3}", "a": "{location2}"},
        {"q": "what is south of the {location1}", "a": "{location2}"}
      ]
    },

    "positional": {
      "templates": [
        "the {item1} is to the left of the {item2} . the {item2} is to the left of the {item3}",
        "the {item2} is to the left of the {item3} . the {item1} is to the left of the {item2}",
        "the {item1} is left of the {item2} . the {item2} is left of the {item3}"
      ],
      "queries": [
        {"q": ["what is to the left of the {item2}", "what is left of the {item2}"], "a": "{item1}"},
        {"q": ["what is to the right of the {item2}", "what is right of the {item2}"], "a": "{item3}"},
        {"q": ["is the {item1} to the left of the {item3}", "is the {item1} left of the {item3}"], "a": "yes"},
        {"q": ["is the {item3} to the left of the {item1}", "is the {item3} left of the {item1}"], "a": "no"}
      ]
    },

    "size_chain": {
      "templates": [
        "the {item1} is bigger than the {item2} . the {item2} is bigger than the {item3}",
        "the {item2} is bigger than the {item3} . the {item1} is bigger than the {item2}"
      ],
      "queries": [
        {"q": "what is bigger than the {item2}", "a": "{item1}"},
        {"q": "what is smaller than the {item2}", "a": "{item3}"},
        {"q": "is the {item1} bigger than the {item3}", "a": "yes"},
        {"q": "is the {item3} bigger than the {item1}", "a": "no"}
      ]
    },

    "navigation": {
      "templates": [
        "the {location1} leads to the {location2} . the {location2} leads to the {location3}",
        "the {location2} leads to the {location3} . the {location1} leads to the {location2}"
      ],
      "queries": [
        {"q": "where can you go from the {location1}", "a": "{location2}"},
        {"q": "where can you go from the {location2}", "a": "{location3}"}
      ]
    },

    "deduction": {
      "templates": [
        "cats like the {item1} . {actor1} is a cat",
        "{actor1} is a cat . cats like the {item1}"
      ],
      "queries": [
        {"q": "what does {actor1} like", "a": "{item1}"}
      ]
    }
  },

  "compositions": [
    {
      "name": "01: Single Supporting Fact",
      "weight": 2.0,
      "chain": ["motion"],
      "connector": " . ",
      "relational_queries": []
    },
    {
      "name": "02: Two Supporting Facts",
      "weight": 2.0,
      "chain": ["acquisition", "motion"],
      "connector": " . then ",
      "relational_queries": [
        {"q": ["where is the {item1} now", "where is the {item1}"], "a": "{location2}"},
        {"q": ["where is {actor1} now", "where is {actor1}"], "a": "{location2}"},
        {"q": "who is in the {location2}", "a": "{actor1}"},
        {"q": "who is in the {location1}", "a": "nobody"}
      ]
    },
    {
      "name": "03: Three Supporting Facts",
      "weight": 2.0,
      "chain": ["acquisition", "drop", "motion"],
      "connector": " . then ",
      "relational_queries": [
        {"q": ["where is the {item1} now", "where is the {item1}"], "a": "{location2}"},
        {"q": ["where is {actor1} now", "where is {actor1}"], "a": "{location3}"},
        {"q": "who has the {item1} now", "a": "nobody"},
        {"q": "who had the {item1} first", "a": "{actor1}"},
        {"q": "who is in the {location3}", "a": "{actor1}"},
        {"q": "who is in the {location1}", "a": "nobody"}
      ]
    },
    {
      "name": "04: Two Argument Relations",
      "weight": 1.5,
      "chain": ["compass"],
      "connector": " . ",
      "relational_queries": []
    },
    {
      "name": "05: Three Argument Relations",
      "weight": 2.0,
      "chain": ["transfer"],
      "connector": " . then ",
      "relational_queries": [
        {"q": "who had the {item1} first", "a": "{actor1}"}
      ]
    },
    {
      "name": "06: Yes/No Truth Verification",
      "weight": 2.5,
      "chain": ["motion"],
      "connector": " . ",
      "relational_queries": [
        {"q": "is {actor1} in the {location1}", "a": "yes"},
        {"q": "is {actor1} in the {location2}", "a": "no"}
      ]
    },
    {
      "name": "07: Counting",
      "weight": 2.0,
      "chain": ["possession_multi"],
      "connector": " . ",
