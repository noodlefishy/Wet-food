{
  "pools": {
    "actor": ["alice", "bob", "felix", "luna"],
    "location": ["garden", "kitchen", "park", "room"],
    "item": ["ball", "box", "book", "cup"],
    "colour": ["red", "blue", "yellow", "green"]
  },
  "states": {
    "needs": [
      {"state": "hungry", "target": "kitchen", "noun": "food"},
      {"state": "tired", "target": "room", "noun": "sleep"},
      {"state": "thirsty", "target": "kitchen", "noun": "water"}
    ]
  },
  "world_rules": {
    "actors_per_story": [1, 2],
    "items_per_actor": [0, 1, 2],
    "state_probability": 0.5
  },
  "predicates": {
    "motion": [
      "{actor} went to the {location}",
      "{actor} is in the {location}",
      "{actor} was in the {location}"
    ],
    "state": [
      "{actor} is {state}",
      "{actor} was {state}"
    ],
    "possession": [
      "{actor} has {items}",
      "{actor} found {items}",
      "{actor} got {items}"
    ]
  },
  "queries": {
    "01: Single Supporting Fact": ["where is {actor}", "who is in the {location}"],
    "06: Yes/No Truth Verification": ["is {actor} in the {location}"],
    "07: Counting": ["how many items does {actor} have"],
    "08: Lists and Sets": ["what does {actor} have", "what did {actor} find"],
    "20: Agent Motivations": ["who is {state}", "why did {actor} go to the {location}"],
    "22: Polar Possession Verification": ["does {actor} have the {item}"],
    "23: Selective Departure (The Frame Problem)": ["where is {actor}", "where did {actor} stay"]
  }
}