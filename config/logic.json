      "chain": ["co_presence", "motion"],
      "connector": " . then they ",
      "relational_queries": [
        {"q": "where is {actor1}", "a": "{location2}"},
        {"q": "where is {actor2}", "a": "{location2}"},
        {"q": "who is in the {location2}", "a": "{actor1} and {actor2}"},
        {"q": "who is in the {location1}", "a": "nobody"}
      ]
    },
    {
      "name": "14: Time Reasoning",
      "weight": 1.5,
      "chain": ["motion"],
