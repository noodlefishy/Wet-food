    },
    {
      "name": "18: Size Reasoning",
      "weight": 1.5,
      "chain": ["size_chain"],
      "connector": " . ",
      "relational_queries": []
    },
    {
      "name": "19: Micro Navigation",
      "weight": 1.5,
      "chain": ["navigation"],
      "connector": " . ",
