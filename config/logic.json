    },
    {
      "name": "10: Indefinite Knowledge",
      "weight": 1.5,
      "chain": ["disjunction"],
      "connector": " . ",
      "relational_queries": []
    },
    {
      "name": "11: Basic Coreference",
      "weight": 1.5,
      "chain": ["motion"],
      "connector": " . then ",
      "relational_queries": [
        {"q": ["where is {agent1_name} now", "where is {agent1_name}"], "a": "{location2}"},
